{
  "schemaVersion": 1,
  "id": "cadeditor",
  "version": "${version}",
  "name": "CAD Editor",
  "icon": "assets/cadeditor/icon.png",
  "authors": ["云诺羲Rinorsi"],
  "contact": {
    "homepage": "https://github.com/Rinorsi/CAD-Editor-Recast",
    "sources": "https://github.com/Rinorsi/CAD-Editor-Recast",
    "issues": "https://github.com/Rinorsi/CAD-Editor-Recast/issues",
    "bilibili": "https://b23.tv/hjUvs0c",
    "afdian": "https://afdian.com/a/Rinorsi"
  },
  "description": "CAD Editor (Recast): visual item component and data editor for Minecraft. UI powered by Oriel UI, by 云诺羲Rinorsi (https://github.com/Rinorsi/Oriel-UI).",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rinorsi.editor.fabric.FabricEditor"
    ],
    "client": [
      "dev.rinorsi.editor.fabric.FabricEditorClient"
    ]
  },
  "accessWidener": "cadeditor.accesswidener",
  "mixins": ["cadeditor.client.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=25",
    "oriel": ">=0.15.0 <0.16.0"
  },
  "custom": {
    "modrinth": {
      "project-id": "${modrinth_id}"
    },
    "curseforge": {
      "project-id": "${curseforge_id}"
    }
  }
}
