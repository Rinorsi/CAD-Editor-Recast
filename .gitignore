# 构建与 IDE
.gradle/
**/build/
.idea/
*.iml
__pycache__/
*.py[cod]
*.class

# 本地运行、日志与一次性产物（可随时删除）
/run/
/logs/
/daily/
/dist/
/reports/
/.backend-b/
/.world-edit/
/.world-entity/
/.world-player/
/.permission/
/.toast/
/.world-merge/
/.world-merge2/
/.world-permission/
/.search-tooltip-api.tmp
/.search/
fabric/versions/*/logs/
fabric/versions/*/run/

# 依赖的 Oriel 发布包：不提交二进制，放到 libs/ 即可（见 README）
/libs/*.jar
/libs/oriel-maven/

# 由 tools/extract-mc-icons.mjs 从本机 Minecraft 资源抽取（Mojang 资源，只在本机预览用）
/dev/browser/mc/

# 脚本生成的状态报告（长期副本在工作区 planning/）
/docs/STATUS*.md
/docs/audit-registry.md
# 历史计划、排查报告与采集回执：仅在本机保留，不提交
/docs/archive/
/.block-edit/

# AI 助手（Cindy 等）的项目指令与 Skill：只在本机使用，不提交
/.cindy/
/.claude/
/.codex/
/AGENTS.md
/CLAUDE.md

# 开发过程笔记、审计与验收回执（由脚本生成或仅作本机记录）
/docs/DEV-NOTES-*.md
/docs/NBT-ROUNDTRIP-AUDIT-*.md
/docs/COVERAGE-signoff.md
/docs/acceptance/
/tools/client-only/*PREPARATION.md

# 宣传片录制产物（含游戏存档、日志、截图）
/promo/raw/
/promo/**/run/
